{
  "name": "modelquest-access",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc && tsc -p server",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "preact": "10.24.3",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.1",
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "concurrently": "9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
